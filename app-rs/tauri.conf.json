{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "brhap",
  "version": "0.1.0",
  "identifier": "coffee.outof.brhap",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "brhap",
        "width": 900,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ]
  }
}
